{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onepic.local/schemas/upload-create-request.json",
  "title": "UploadCreateRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["declaredBytes", "declaredMime"],
  "properties": {
    "declaredBytes": { "type": "integer", "minimum": 1, "maximum": 20971520 },
    "declaredMime": { "type": "string", "enum": ["image/jpeg", "image/png", "image/webp"] }
  }
}
