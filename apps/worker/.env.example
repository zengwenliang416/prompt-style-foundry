# OnePic Worker placeholders only. Never commit a real provider key.
DATABASE_URL=postgresql://onepic:local-password@127.0.0.1:5432/onepic
MEDIA_STORAGE_ROOT=.tmp/onepic-media
CLEANUP_INTERVAL_SECONDS=300
METRICS_HOST=127.0.0.1
METRICS_PORT=9090

# Generation consumption is explicit opt-in. When false, Worker only runs
# retention and internal health/metrics.
WORKER_GENERATION_ENABLED=false
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=500
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_SHUTDOWN_GRACE_SECONDS=30

# Required only when WORKER_GENERATION_ENABLED=true. Base URL is server-owned
# allowlist configuration; it is never accepted from an API request. HTTP is
# accepted only for a loopback test provider.
# WORKER_PROVIDER_ID=managed-primary
# WORKER_PROVIDER_LABEL=Managed provider
# WORKER_PROVIDER_BASE_URL=https://images.example.com
# WORKER_PROVIDER_API_KEY=replace-from-secret-manager
# Format: model:quality+quality,model2:quality
# WORKER_PROVIDER_MODELS=gpt-image-2:high+medium
