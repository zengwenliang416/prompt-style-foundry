# OnePic API configuration example — placeholders only, safe to commit.
# Copy to apps/api/.env and fill in real values; never commit the real .env.
# Load with: node --env-file=apps/api/.env apps/api/dist/server.js
#
# Validation rules live in apps/api/src/config/env.ts. Invalid or missing
# values fail startup with a structured error; secret values are never
# printed back.

# Listen address / port.
HOST=127.0.0.1
PORT=8080

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# catalog-only | direct-byok | managed-generation
# Defaults to catalog-only when unset. managed-generation additionally
# requires the identity and storage fields below; it refuses to start
# without them (ADR 0001 D-4).
RUN_MODE=catalog-only

# --- Required only for RUN_MODE=managed-generation ------------------------
# PostgreSQL metadata/job store (the value is treated as a secret: never
# logged).
# DATABASE_URL=postgresql://user:password@localhost:5432/onepic
# Trusted OIDC identity source (authorization code + PKCE).
# http:// is only accepted for localhost/loopback dev providers.
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=onepic-api
# OIDC_CLIENT_SECRET=replace-me
# OIDC_REDIRECT_URI=https://api.example.com/api/v1/auth/callback
# Server-side opaque session signing secret; at least 32 characters.
# SESSION_SECRET=replace-with-32-bytes-of-random-hex
